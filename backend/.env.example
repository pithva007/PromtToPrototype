# Server Configuration
PORT=3001

# CORS Configuration (frontend URL)
CORS_ORIGIN=http://localhost:3000

# File Upload Limits
MAX_FILE_SIZE=5242880
# 5MB in bytes (5 * 1024 * 1024)

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
# 15 minutes in milliseconds
RATE_LIMIT_MAX_REQUESTS=100

# ML Service Configuration  
ML_SERVICE_URL=http://localhost:8000
ML_THRESHOLD=0.80
# Threshold for classifying URL as malicious (0.0 to 1.0) - INCREASED from 0.60 to reduce false positives

# Safe Domains Allowlist (False-Positive Mitigation)
SAFE_OVERRIDE_MAX=0.95
# Maximum ML score to allow override for trusted domains (0.0 to 1.0)

SAFE_DOMAINS=instagram.com,linkedin.com,codeforces.com,github.com,google.com,youtube.com,facebook.com,twitter.com,amazon.com,microsoft.com
# Comma-separated list of trusted domains (override ML for scores < SAFE_OVERRIDE_MAX)
